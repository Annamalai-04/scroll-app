<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@android:color/transparent">


    <!-- ================================= -->
    <!-- USER HEADER - FIXED -->
    <!-- ================================= -->

    <LinearLayout
        android:id="@+id/userBox"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/transparent">

        <!-- NAME -->

        <TextView
            android:id="@+id/loggedInUserName"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="Hi, name"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="none"
            android:paddingStart="5dp"
            android:paddingEnd="5dp" />


        <!-- LOGOUT -->

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="110dp"
            android:layout_height="55dp"
            android:text="LOGOUT"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/panel_tab_selector"
            android:padding="0dp" />

    </LinearLayout>


    <!-- ================================= -->
    <!-- HISTORY TITLE - FIXED -->
    <!-- ================================= -->

    <!-- ================================= -->
    <!-- HISTORY HEADER -->
    <!-- ================================= -->

    <LinearLayout
        android:id="@+id/historyHeader"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@android:color/transparent">

        <TextView
            android:id="@+id/historyTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="HISTORY"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/refreshHistoryButton"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_marginEnd="5dp"
            android:text="REFRESH"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/panel_tab_selector"
            android:padding="0dp" />

    </LinearLayout>


    <!-- ================================= -->
    <!-- HISTORY SCROLL AREA -->
    <!-- ================================= -->

    <ScrollView
        android:id="@+id/historyBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:fillViewport="false"
        android:scrollbars="vertical">

        <!-- ONLY ONE DIRECT CHILD -->

        <LinearLayout
            android:id="@+id/historyContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="5dp"
            android:background="@android:color/transparent">




            <!-- EXTRA SPACE -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="30dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>